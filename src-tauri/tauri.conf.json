{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hush_UI",
  "version": "0.4.0-beta.2",
  "identifier": "com.hush_ui.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": " ",
        "url": "launcher/index.html",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "fullscreen": false,
        "center": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "screensaver",
        "title": "Hush_UI — Screensaver",
        "url": "screensaver/index.html",
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "notification",
        "title": " ",
        "url": "notification/index.html",
        "width": 340,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "hushlight",
        "title": "Hush_UI — Hushlight",
        "url": "hushlight/index.html",
        "width": 540,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "center": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "tables",
        "title": " ",
        "url": "tables/index.html",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "fullscreen": false,
        "center": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "table-taskbar",
        "title": " ",
        "url": "table-taskbar/index.html",
        "width": 260,
        "height": 324,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "center": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "table-settings",
        "title": "Hush_UI — Settings",
        "url": "table-settings/index.html",
        "width": 400,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "center": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "table-widgets",
        "title": "Hush_UI — Widgets",
        "url": "table-widgets/index.html",
        "width": 340,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "center": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "tutorial",
        "title": "Hush_UI — Tutorial",
        "url": "tutorial/index.html",
        "width": 560,
        "height": 470,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "center": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "table-desktop",
        "title": "Hush_UI — Desktop",
        "url": "table-desktop/index.html",
        "width": 620,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "center": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/fonts/*.woff2"
    ]
  }
}
